{
  "name": "obsidian-picbed-manager",
  "version": "0.2.0",
  "description": "Upload pasted images from Obsidian to a configurable custom image hosting API.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src tests",
    "check": "eslint src tests && tsc --noEmit && vitest run && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "image-upload",
    "picbed"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "esbuild": "^0.25.5",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^3.2.4"
  }
}
