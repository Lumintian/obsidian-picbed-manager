{
  "name": "obsidian-picbed-manager",
  "version": "0.2.0",
  "description": "Upload pasted images and Excalidraw images from Obsidian to a configurable custom image hosting API.",
  "main": "main.js",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "check": "eslint src tests && tsc --noEmit && vitest run && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "image-upload",
    "picbed"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.6.0",
    "obsidian": "1.13.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.11"
  }
}
